# Preserve captured reference artifacts byte-for-byte.
reference/*.html -text
reference/*.png -text

# Keep the checksum manifest LF-only so `sha256sum -c` works on Windows
# (CRLF checkout would leave `\r` as part of each filename).
reference/SHA256SUMS text eol=lf

# Normalize authored text files in the repository.
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
