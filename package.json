    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^26.1.0",
    "oxlint": "^1.75.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
